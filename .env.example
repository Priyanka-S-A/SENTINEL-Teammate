# SENTINEL LLM Provider Configuration
LLM_PROVIDER=groq

# Groq Configuration (Primary / Fast Inference Provider)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# OpenRouter Configuration (Alternative Provider)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Gemini Configuration (Alternative Provider)
GEMINI_API_KEY=

# Persistent Database Configuration (PostgreSQL with SQLite fallback)
DATABASE_URL=
# Example PostgreSQL: postgresql://user:password@localhost:5432/sentinel_db
# Default Fallback: sqlite:///sentinel.db

# Live Threat Intelligence API Keys (Phase 3)
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
URLSCAN_API_KEY=
